{
  "manifest_version": 3,
  "name": "Glasspect",
  "version": "1.0",
  "description": "Inspect CSS styles in real-time with a sleek glassmorphic floating overlay card.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}